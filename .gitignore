node_modules/
dist/
models/
*.tar.bz2

# build/ holds only the macOS entitlements the signer needs. Icons live in
# assets/ and are committed: they are generated once from the logo, not built.
build/*
!build/entitlements.mac.plist

# Throwaway userData for test runs (test/user-data.js)
.test-userdata/

# Environments & Local Configuration
.env
.env.*
!.env.example

# Installer & Release Outputs
out/
release/
*.dmg
*.exe
*.zip

# OS Junk
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Signing material - never commit. These live in GitHub Actions secrets.
*.p12
*.p8
*.cer
*.csr
*.key
*.pem

